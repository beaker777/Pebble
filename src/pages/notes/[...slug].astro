---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { VOLUME_MAP } from '../../data/volumes';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const volume = VOLUME_MAP[note.data.volume];

const allNotes = await getCollection('notes');
const volumeNotes = allNotes
  .filter((n) => n.data.volume === note.data.volume)
  .sort((a, b) => a.data.order - b.data.order);

const currentIdx = volumeNotes.findIndex((n) => n.id === note.id);
const prevNote = currentIdx > 0 ? volumeNotes[currentIdx - 1] : null;
const nextNote = currentIdx >= 0 && currentIdx < volumeNotes.length - 1 ? volumeNotes[currentIdx + 1] : null;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const accentInk = volume.designKey === 'juc' ? '#1D4491' : volume.designKey === 'spring' ? '#4D6658' : volume.coverBg;
---

<BaseLayout title={`${note.data.title} — ${volume.title} · Pebble Press`} description={note.data.summary}>
  <!-- Hairline Reading Progress Bar -->
  <div class="fixed top-[50px] left-0 right-0 h-[2px] z-40 pointer-events-none bg-transparent">
    <div
      id="reading-progress-bar"
      class="h-full transition-[width] duration-75"
      style={`width: 0%; background-color: ${accentInk};`}
    ></div>
  </div>

  <!-- Seamless Museum Paper Surface (Unboxed Fine-Press Reading Room) -->
  <div class="bg-[#f9f7f1] min-h-[calc(100vh-50px)]" style={`--vol-accent: ${accentInk};`}>
    <!-- Quiet Archival Breadcrumb Strip -->
    <div class="border-b border-[#e5e1d6]">
      <div class="max-w-[1460px] mx-auto px-5 sm:px-10 h-11 flex items-center justify-between gap-4 text-[11px] font-mono-meta tracking-[0.12em] uppercase text-[#757268]">
        <nav class="flex items-center gap-2.5 min-w-0">
          <a href="/" class="hover:text-[#141820] transition">VOLUMES</a>
          <span class="opacity-45">/</span>
          <a href={`/volumes/${volume.id}`} class="hover:text-[#141820] transition flex items-center gap-2">
            <span class="w-2 h-2 rounded-full inline-block" style={`background:${accentInk};`}></span>
            <span>{volume.title}</span>
          </a>
          <span class="hidden sm:inline opacity-45">/</span>
          <span class="hidden sm:inline text-[#141820]">CHAPTER {String(currentIdx + 1).padStart(2, '0')}</span>
        </nav>

        <div class="flex items-center gap-4 shrink-0">
          <span>{note.data.readTime}</span>
          {note.data.updatedAt && <span class="hidden sm:inline opacity-70">{note.data.updatedAt}</span>}
        </div>
      </div>
    </div>

    <!-- Wide Open Editorial 3-Column Reading Grid -->
    <div class="max-w-[1460px] mx-auto px-5 sm:px-10 py-11 lg:py-14 grid grid-cols-1 lg:grid-cols-[215px_minmax(0,1fr)] xl:grid-cols-[215px_minmax(0,1fr)_185px] gap-10 xl:gap-14 items-start">
      <!-- Left Rail: Unboxed Quiet Volume Index -->
      <aside class="hidden lg:block sticky top-24 pr-4 border-r border-[#e6e2d7]">
        <a href={`/volumes/${volume.id}`} class="group block pb-5 mb-5 border-b border-[#e6e2d7]">
          <div class="flex items-center gap-2">
            <span class="w-[3px] h-4 rounded-full" style={`background-color: ${accentInk};`}></span>
            <span class="font-mono-meta text-[10px] tracking-[0.18em] uppercase text-[#757268]">
              VOL. {volume.number}
            </span>
          </div>
          <div class="font-editorial text-2xl font-bold text-[#141820] group-hover:opacity-75 transition mt-1.5 leading-none">
            {volume.title}
          </div>
          <div class="font-book-serif italic text-xs text-[#757268] mt-1.5">
            {volume.subtitle}
          </div>
        </a>

        <div class="space-y-1">
          {volumeNotes.map((item, idx) => {
            const active = item.id === note.id;
            return (
              <a
                href={`/notes/${item.id}`}
                data-sidebar-slug={item.id}
                class:list={[
                  'relative flex items-start gap-2.5 py-2.5 pl-3 pr-1 text-[13px] leading-snug transition border-l-[2px]',
                  active
                    ? 'text-[#141820] font-medium'
                    : 'border-transparent text-[#6f6c63] hover:text-[#141820]',
                ]}
                style={active ? `border-left-color: ${accentInk};` : undefined}
              >
                <span class="font-mono-meta text-[10.5px] opacity-65 shrink-0 mt-0.5">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <span class="flex-1">{item.data.title}</span>
                <span data-sidebar-check={item.id} class="font-mono-meta text-[11px] shrink-0" style={`color:${accentInk};`}></span>
              </a>
            );
          })}
        </div>
      </aside>

      <!-- Center: Unboxed Seamless Fine-Press Monograph Sheet -->
      <article class="min-w-0 w-full max-w-[880px] mx-auto">
        <!-- Classic Book Chapter Masthead -->
        <header class="space-y-5 pb-8">
          <div class="flex flex-wrap items-center gap-3 font-mono-meta text-[11px] tracking-[0.14em] uppercase text-[#757268]">
            <span>[ CHAPTER {String(currentIdx + 1).padStart(2, '0')} ]</span>
            <span class="opacity-40">·</span>
            <span class="inline-flex items-center gap-1.5" style={`color: ${accentInk};`}>
              <span class="w-1.5 h-1.5 rounded-full inline-block" style={`background-color: ${accentInk};`}></span>
              <span>{note.data.frequency}</span>
            </span>
            {note.data.tags.length > 0 && (
              <>
                <span class="opacity-40">·</span>
                <span class="normal-case tracking-normal text-[#757268]">
                  {note.data.tags.join(' / ')}
                </span>
              </>
            )}
          </div>

          <h1 class="font-editorial text-3xl sm:text-[2.75rem] font-bold tracking-[-0.02em] leading-[1.18] text-[#11151d]">
            {note.data.title}
          </h1>

          {note.data.subtitle && (
            <p class="font-book-serif italic text-[17px] sm:text-[19px] text-[#555b66] leading-relaxed">
              {note.data.subtitle}
            </p>
          )}
        </header>

        <!-- Classical Printed Double Rule -->
        <div class="editorial-double-rule mb-9"></div>

        <!-- Literary Epigraph / Interview One-Liner Abstract -->
        <aside
          class="relative mb-11 px-6 sm:px-7 py-5 bg-[#f2efe6] border-l-[2.5px]"
          style={`border-left-color: ${accentInk};`}
        >
          <div class="font-mono-meta text-[10px] tracking-[0.18em] uppercase text-[#757268] mb-2">
            EPIGRAPH · 面试一句话速答
          </div>
          <p class="text-[15.5px] leading-[1.85] text-[#161b24] font-medium">
            {note.data.summary}
          </p>
        </aside>

        <!-- Main Monograph Prose -->
        <div id="article-prose" class="prose-press">
          <Content />
        </div>

        <!-- Ornamental Colophon End-Mark & Minimal Mastery Toggle -->
        <div class="mt-16 pt-8 border-t border-[#dfdace] flex flex-col sm:flex-row sm:items-center justify-between gap-5">
          <div class="flex items-center gap-3 text-[#757268]">
            <svg class="w-4 h-5 opacity-75" viewBox="0 0 24 30" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="3" width="16" height="24" rx="8" />
              <rect x="7.5" y="6.5" width="9" height="10" rx="4.5" />
              <line x1="7.5" y1="12" x2="7.5" y2="23.5" />
            </svg>
            <span class="font-mono-meta text-[10.5px] tracking-[0.16em] uppercase">
              END OF CHAPTER {String(currentIdx + 1).padStart(2, '0')}
            </span>
          </div>

          <button
            id="toggle-mastery-btn"
            data-current-slug={note.id}
            type="button"
            class="inline-flex items-center justify-center gap-2 px-4 py-2 font-mono-meta text-[11px] tracking-[0.1em] uppercase border border-[#141820] text-[#141820] hover:bg-[#141820] hover:text-[#f9f7f1] transition cursor-pointer"
          >
            标记为已掌握
          </button>
        </div>

        <!-- Clean Unboxed Chapter Navigation -->
        {(prevNote || nextNote) && (
          <nav class="mt-10 pt-8 border-t border-[#e6e2d7] grid grid-cols-1 sm:grid-cols-2 gap-8">
            {prevNote ? (
              <a href={`/notes/${prevNote.id}`} class="group block space-y-1.5">
                <div class="font-mono-meta text-[10px] tracking-[0.16em] uppercase text-[#757268]">
                  ← PREVIOUS
                </div>
                <div class="font-editorial text-xl font-bold text-[#141820] group-hover:underline underline-offset-4 decoration-[#bfb9aa]">
                  {prevNote.data.title}
                </div>
              </a>
            ) : (
              <div></div>
            )}

            {nextNote && (
              <a href={`/notes/${nextNote.id}`} class="group block space-y-1.5 text-left sm:text-right">
                <div class="font-mono-meta text-[10px] tracking-[0.16em] uppercase text-[#757268]">
                  NEXT →
                </div>
                <div class="font-editorial text-xl font-bold text-[#141820] group-hover:underline underline-offset-4 decoration-[#bfb9aa]">
                  {nextNote.data.title}
                </div>
              </a>
            )}
          </nav>
        )}
      </article>

      <!-- Right Rail: Quiet Scroll-Spy Table of Contents -->
      <aside class="hidden xl:block sticky top-24">
        {tocHeadings.length > 0 && (
          <div class="space-y-3">
            <div class="font-mono-meta text-[10px] tracking-[0.18em] uppercase text-[#757268]">
              [ ON THIS PAGE ]
            </div>
            <ul id="toc-list" class="space-y-2 border-l border-[#e6e2d7] pl-3.5">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? 'pl-2.5' : ''}>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class="block text-xs text-[#757268] hover:text-[#141820] leading-snug transition"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // 1. Mastery Toggle + Sidebar Checkmarks
  const btn = document.getElementById('toggle-mastery-btn');
  const currentSlug = btn?.getAttribute('data-current-slug') || '';

  function syncNoteMastery() {
    const mastered = new Set(window.PebbleMastery?.getAll() || []);
    const isDone = mastered.has(currentSlug);

    if (btn) {
      if (isDone) {
        btn.textContent = '✓ 已掌握';
        btn.className = 'inline-flex items-center justify-center gap-2 px-4 py-2 font-mono-meta text-[11px] tracking-[0.1em] uppercase border border-[#244237] bg-[#244237] text-[#f9f7f1] hover:opacity-90 transition cursor-pointer';
      } else {
        btn.textContent = '标记为已掌握';
        btn.className = 'inline-flex items-center justify-center gap-2 px-4 py-2 font-mono-meta text-[11px] tracking-[0.1em] uppercase border border-[#141820] text-[#141820] hover:bg-[#141820] hover:text-[#f9f7f1] transition cursor-pointer';
      }
    }

    document.querySelectorAll('[data-sidebar-check]').forEach((el) => {
      const slug = el.getAttribute('data-sidebar-check') || '';
      el.textContent = mastered.has(slug) ? '✓' : '';
    });
  }

  btn?.addEventListener('click', () => {
    if (!currentSlug) return;
    window.PebbleMastery?.toggle(currentSlug);
  });

  syncNoteMastery();
  window.addEventListener('pebble:mastery-changed', syncNoteMastery);

  // 2. Subtle Hairline Reading Progress Bar
  const progressBar = document.getElementById('reading-progress-bar');
  function updateProgress() {
    if (!progressBar) return;
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
    progressBar.style.width = `${pct.toFixed(1)}%`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // 3. Scroll-Spy Highlighting for Right TOC
  const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
  const headingEls = tocLinks
    .map((a) => document.getElementById(a.getAttribute('data-toc-link') || ''))
    .filter((el): el is HTMLElement => Boolean(el));

  if (headingEls.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((e) => e.isIntersecting);
        if (!visible) return;
        const id = visible.target.id;
        tocLinks.forEach((link) => {
          const isAct = link.getAttribute('data-toc-link') === id;
          link.classList.toggle('text-[#141820]', isAct);
          link.classList.toggle('font-medium', isAct);
          link.classList.toggle('text-[#757268]', !isAct);
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    headingEls.forEach((h) => observer.observe(h));
  }

  // 4. Unobtrusive Hover-Revealed Copy Button on Code Exhibits
  document.querySelectorAll('#article-prose pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-block-wrap group';
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.textContent = 'COPY';
    copyBtn.className = 'absolute top-2.5 right-2.5 font-mono-meta text-[10px] tracking-[0.12em] px-2 py-0.5 rounded-[3px] bg-[#f9f7f1]/90 text-[#6f6c63] hover:text-[#141820] border border-[#dcd7ca] opacity-70 group-hover:opacity-100 transition cursor-pointer';
    copyBtn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent || pre.textContent || '';
      try {
        await navigator.clipboard.writeText(code);
        copyBtn.textContent = 'COPIED ✓';
        setTimeout(() => (copyBtn.textContent = 'COPY'), 1500);
      } catch {
        copyBtn.textContent = 'ERROR';
      }
    });
    wrap.appendChild(copyBtn);
  });
</script>
