---
import type { VolumeMeta } from '../data/volumes';

interface Props {
  volume: VolumeMeta;
  size?: 'hero' | 'lg';
  idPrefix?: string;
}

const { volume, size = 'hero', idPrefix = 'book' } = Astro.props;
const isHero = size === 'hero';
---

<div
  class="book3d-object"
  data-book3d
  data-size={size}
  data-volume-id={volume.id}
  id={`${idPrefix}-${volume.id}`}
>
  <!-- ======================================================================
       1. FRONT COVER — CRISP NATIVE HTML TYPOGRAPHY + ARCHITECTURE ARTWORK
       ====================================================================== -->
  <div
    class="book3d-face book3d-front relative overflow-hidden"
    style={`background-color: ${volume.coverBg}; color: ${volume.coverText};`}
  >
    <div class="book3d-glare" data-glare></div>

    {/* ---------- 01. MySQL: Olive Buckram Monograph + InnoDB B+ Tree ---------- */}
    {volume.designKey === 'mysql' && (
      <div class="relative z-10 w-full h-full flex flex-col justify-between p-7 sm:p-9 pl-9 sm:pl-11">
        <img
          src="/covers/mysql-cloth.jpg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 w-full h-full object-cover"
        />

        <!-- Signature top-right burnished gold cloth tab -->
        <div
          class="absolute top-0 right-5 w-10 h-12 flex items-center justify-center z-20"
          style="background-color: #D9BC6E; color: #363B30;"
        >
          <svg class="w-5 h-6" viewBox="0 0 24 30" fill="none" stroke="currentColor" stroke-width="1.85">
            <rect x="4" y="3" width="16" height="24" rx="8" />
            <rect x="7.5" y="6.5" width="9" height="10" rx="4.5" />
            <line x1="7.5" y1="12" x2="7.5" y2="23.5" />
          </svg>
        </div>

        <!-- Upper-left crisp editorial typography -->
        <div class="relative z-10 mt-5 max-w-[210px]">
          <h3 class:list={['font-editorial font-semibold tracking-tight leading-none', isHero ? 'text-[3.35rem]' : 'text-[2.65rem]']}>
            MySQL
          </h3>
          <div class="w-7 h-[1px] my-3 opacity-65" style="background-color: #DFC06C;"></div>
          <p class="font-book-serif italic text-[14.5px] leading-snug opacity-92">
            Storage Engines,<br />B+ Trees &amp; MVCC
          </p>
        </div>

        <!-- Crisp Vector 3-Tier InnoDB B+ Tree & Linked Leaf Chain -->
        <svg
          class="relative z-10 w-full max-w-[258px] my-auto opacity-90"
          viewBox="0 0 260 132"
          fill="none"
          stroke="#E4C675"
          stroke-width="1.1"
          aria-hidden="true"
        >
          <!-- Root node -->
          <rect x="94" y="6" width="72" height="15" />
          <line x1="118" y1="6" x2="118" y2="21" />
          <line x1="142" y1="6" x2="142" y2="21" />
          <!-- Level 1 connectors -->
          <path d="M106 21 V36 H52 V48 M130 21 V48 M154 21 V36 H208 V48" />
          <!-- Internal nodes -->
          <rect x="26" y="48" width="52" height="14" />
          <line x1="52" y1="48" x2="52" y2="62" />
          <rect x="104" y="48" width="52" height="14" />
          <line x1="130" y1="48" x2="130" y2="62" />
          <rect x="182" y="48" width="52" height="14" />
          <line x1="208" y1="48" x2="208" y2="62" />
          <!-- Level 2 connectors -->
          <path d="M52 62 V80 H26 V92 M52 80 H78 V92 M130 62 V92 M208 62 V80 H182 V92 M208 80 H234 V92" />
          <!-- 5 Clustered Leaf Pages -->
          <rect x="7" y="92" width="38" height="20" />
          <rect x="59" y="92" width="38" height="20" />
          <rect x="111" y="92" width="38" height="20" />
          <rect x="163" y="92" width="38" height="20" />
          <rect x="215" y="92" width="38" height="20" />
          <!-- Row lines inside leaf pages -->
          <path d="M13 99 H39 M13 105 H33 M65 99 H91 M65 105 H85 M117 99 H143 M117 105 H137 M169 99 H195 M169 105 H189 M221 99 H247 M221 105 H241" stroke-opacity="0.55" />
          <!-- Doubly-linked sequential scan pointers -->
          <path d="M45 100 H59 M45 104 H59 M97 100 H111 M97 104 H111 M149 100 H163 M149 104 H163 M201 100 H215 M201 104 H215" />
        </svg>

        <!-- Quiet lower-left colophon -->
        <div class="relative z-10 mb-1">
          <p class="font-book-serif italic text-[14.5px] opacity-90">InnoDB Internals</p>
          <p class="font-mono-meta text-[8.5px] tracking-[0.24em] uppercase opacity-60 mt-1">
            PEBBLE PRESS
          </p>
        </div>
      </div>
    )}

    {/* ---------- 02. RAG: Prussian Indigo Linen + Vector Space Retrieval & Pipeline ---------- */}
    {volume.designKey === 'rag' && (
      <div class="relative z-10 w-full h-full flex flex-col justify-between p-5 sm:p-6 pl-7 sm:pl-8 text-[#EFEBE0]">
        <img
          src="/covers/rag-linen.jpg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 w-full h-full object-cover"
        />

        <!-- Architectural blueprint double-hairline monograph frame -->
        <div class="relative z-10 w-full h-full border border-[#EFEBE0]/20 flex flex-col justify-between p-5 sm:p-6 overflow-hidden">
          <!-- Top Archival Strip & Editorial Title -->
          <div>
            <div class="flex items-center justify-between pb-2.5 border-b border-[#EFEBE0]/20 font-mono-meta text-[7.5px] tracking-[0.22em] uppercase text-[#DDA15E]">
              <span>NO. 02</span>
              <span>RETRIEVAL · AUGMENT</span>
            </div>

            <div class="mt-4 flex items-baseline justify-between gap-2">
              <h3
                class:list={[
                  'font-editorial font-semibold tracking-[0.04em] leading-none text-[#EFEBE0]',
                  isHero ? 'text-[3.8rem]' : 'text-[2.95rem]',
                ]}
              >
                RAG
              </h3>
              <span class="font-mono-meta text-[8px] tracking-[0.16em] uppercase text-[#EFEBE0]/55">
                cos(q, d)
              </span>
            </div>

            <div class="w-8 h-[1px] bg-[#DDA15E] my-2.5 opacity-80"></div>
            <p class="font-book-serif italic text-[13.5px] leading-snug text-[#EFEBE0]/85">
              Retrieval-Augmented Generation
            </p>
          </div>

          <!-- Centerpiece Crisp Vector Artwork: Embedding Nearest-Neighbor Constellation + Pipeline -->
          <div class="relative my-auto py-2">
            <svg
              class="w-full h-auto block"
              viewBox="0 0 264 158"
              fill="none"
              aria-hidden="true"
            >
              <!-- Subtle Embedding Space Coordinate Grid -->
              <g stroke="#EFEBE0" stroke-opacity="0.1" stroke-width="0.7">
                <line x1="132" y1="4" x2="132" y2="112" />
                <line x1="22" y1="58" x2="242" y2="58" />
                <line x1="56" y1="14" x2="208" y2="102" />
                <line x1="208" y1="14" x2="56" y2="102" />
              </g>

              <!-- Concentric Cosine Similarity Rings around Query Vector q -->
              <circle cx="132" cy="58" r="24" stroke="#DDA15E" stroke-opacity="0.55" stroke-width="0.9" />
              <circle cx="132" cy="58" r="44" stroke="#EFEBE0" stroke-opacity="0.28" stroke-width="0.85" stroke-dasharray="2.5 4" />
              <circle cx="132" cy="58" r="66" stroke="#EFEBE0" stroke-opacity="0.14" stroke-width="0.75" />

              <!-- Outer Corpus Document Chunk Nodes (Unselected) -->
              <g stroke="#EFEBE0" stroke-opacity="0.42" stroke-width="0.9" fill="#192B42">
                <rect x="34" y="22" width="7" height="7" />
                <rect x="64" y="88" width="7" height="7" />
                <rect x="218" y="26" width="7" height="7" />
                <rect x="206" y="84" width="7" height="7" />
                <rect x="44" y="62" width="6" height="6" />
                <rect x="226" y="58" width="6" height="6" />
                <circle cx="88" cy="14" r="2.2" fill="#EFEBE0" fill-opacity="0.35" stroke="none" />
                <circle cx="184" cy="18" r="2.2" fill="#EFEBE0" fill-opacity="0.35" stroke="none" />
                <circle cx="166" cy="100" r="2.2" fill="#EFEBE0" fill-opacity="0.35" stroke="none" />
                <circle cx="96" cy="96" r="2.2" fill="#EFEBE0" fill-opacity="0.35" stroke="none" />
              </g>

              <!-- HNSW Sparse Graph Edges among Neighbors -->
              <g stroke="#EFEBE0" stroke-opacity="0.2" stroke-width="0.75">
                <line x1="38" y1="26" x2="96" y2="38" />
                <line x1="96" y1="38" x2="152" y2="34" />
                <line x1="152" y1="34" x2="221" y2="29" />
                <line x1="170" y1="70" x2="209" y2="87" />
                <line x1="68" y1="91" x2="108" y2="74" />
                <line x1="108" y1="74" x2="170" y2="70" />
              </g>

              <!-- Top-K Retrieved Similarity Vectors from Query q -->
              <g stroke="#DDA15E" stroke-width="1.2">
                <line x1="132" y1="58" x2="96" y2="38" />
                <line x1="132" y1="58" x2="152" y2="34" />
                <line x1="132" y1="58" x2="170" y2="70" />
                <line x1="132" y1="58" x2="108" y2="74" />
              </g>

              <!-- Top-K Matched Chunk Nodes (Copper-Gold Accents) -->
              <g fill="#DDA15E" stroke="#EFEBE0" stroke-width="0.8">
                <circle cx="96" cy="38" r="3.4" />
                <circle cx="152" cy="34" r="3.4" />
                <circle cx="170" cy="70" r="3.2" />
                <circle cx="108" cy="74" r="3.2" />
              </g>

              <!-- Central Query Vector Node q -->
              <circle cx="132" cy="58" r="6.5" fill="#192B42" stroke="#EFEBE0" stroke-width="1.4" />
              <circle cx="132" cy="58" r="2.6" fill="#DDA15E" />

              <!-- Classic 4-Stage RAG Architecture Pipeline -->
              <g transform="translate(0, 126)">
                <rect x="4" y="0" width="52" height="19" stroke="#EFEBE0" stroke-opacity="0.55" stroke-width="0.9" />
                <text x="30" y="12.5" text-anchor="middle" fill="#EFEBE0" fill-opacity="0.88" font-family="JetBrains Mono, monospace" font-size="7" letter-spacing="0.6">CHUNKS</text>

                <line x1="56" y1="9.5" x2="72" y2="9.5" stroke="#EFEBE0" stroke-opacity="0.55" stroke-width="0.9" />
                <path d="M69 7 L72.5 9.5 L69 12" stroke="#EFEBE0" stroke-opacity="0.55" stroke-width="0.9" />

                <rect x="73" y="0" width="52" height="19" stroke="#EFEBE0" stroke-opacity="0.55" stroke-width="0.9" />
                <text x="99" y="12.5" text-anchor="middle" fill="#EFEBE0" fill-opacity="0.88" font-family="JetBrains Mono, monospace" font-size="7" letter-spacing="0.6">EMBED</text>

                <line x1="125" y1="9.5" x2="141" y2="9.5" stroke="#DDA15E" stroke-width="1" />
                <path d="M138 7 L141.5 9.5 L138 12" stroke="#DDA15E" stroke-width="1" />

                <rect x="142" y="0" width="54" height="19" fill="#DDA15E" fill-opacity="0.16" stroke="#DDA15E" stroke-width="1.05" />
                <text x="169" y="12.5" text-anchor="middle" fill="#DDA15E" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600" letter-spacing="0.6">RERANK</text>

                <line x1="196" y1="9.5" x2="212" y2="9.5" stroke="#DDA15E" stroke-width="1" />
                <path d="M209 7 L212.5 9.5 L209 12" stroke="#DDA15E" stroke-width="1" />

                <rect x="213" y="0" width="47" height="19" stroke="#EFEBE0" stroke-opacity="0.75" stroke-width="0.95" />
                <text x="236.5" y="12.5" text-anchor="middle" fill="#EFEBE0" font-family="JetBrains Mono, monospace" font-size="7" font-weight="600" letter-spacing="0.8">LLM</text>
              </g>
            </svg>
          </div>

          <!-- Quiet Bottom Colophon -->
          <div class="pt-2.5 border-t border-[#EFEBE0]/18 flex items-center justify-between">
            <span class="font-mono-meta text-[7.5px] tracking-[0.2em] uppercase text-[#EFEBE0]/65">
              HYBRID · HNSW · GROUNDED
            </span>
            <svg class="w-3.5 h-[18px] text-[#DDA15E]/90 shrink-0" viewBox="0 0 24 30" fill="none" stroke="currentColor" stroke-width="1.75">
              <rect x="4" y="3" width="16" height="24" rx="8" />
              <rect x="7.5" y="6.5" width="9" height="10" rx="4.5" />
              <line x1="7.5" y1="12" x2="7.5" y2="23.5" />
            </svg>
          </div>
        </div>
      </div>
    )}
  </div>

  <!-- ======================================================================
       2. MINIMAL CENTERED BACK COVER
       ====================================================================== -->
  <div
    class="book3d-face book3d-back relative overflow-hidden flex flex-col items-center justify-center p-10 text-center"
    style={`background-color: ${volume.coverBg}; color: ${volume.coverText};`}
  >
    {volume.designKey === 'mysql' && (
      <img
        src="/covers/mysql-cloth.jpg"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 w-full h-full object-cover -scale-x-100 opacity-95"
      />
    )}
    {volume.designKey === 'rag' && (
      <img
        src="/covers/rag-linen.jpg"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 w-full h-full object-cover -scale-x-100 opacity-95"
      />
    )}

    <div class="relative z-10 space-y-3.5 max-w-[220px]">
      <svg
        class="w-7 h-9 mx-auto opacity-85"
        style={volume.designKey === 'rag' ? 'color: #DDA15E;' : undefined}
        viewBox="0 0 24 30"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <rect x="4" y="3" width="16" height="24" rx="8" />
        <rect x="7.5" y="6.5" width="9" height="10" rx="4.5" />
        <line x1="7.5" y1="12" x2="7.5" y2="23.5" />
      </svg>
      <div class="font-mono-meta text-[8.5px] tracking-[0.2em] uppercase opacity-70">
        PEBBLE PRESS · {volume.edition}
      </div>
      <p class="font-book-serif italic text-[13.5px] leading-snug opacity-85">
        {volume.subtitle}
      </p>
    </div>
  </div>

  <!-- ======================================================================
       3. DRY VELVETY MATTE SPINE — RAZOR-SHARP NATIVE HTML TYPOGRAPHY
       ====================================================================== -->
  <div
    class="book3d-face book3d-spine"
    style={`background-color: ${volume.spineBg}; color: ${volume.spineText};`}
  >
    {volume.designKey === 'mysql' && (
      <>
        <img
          src="/covers/mysql-cloth.jpg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 w-full h-full object-cover object-left"
        />
        <span class="relative z-10 font-mono-meta text-[8px] tracking-[0.24em] uppercase opacity-75">
          PEBBLE
        </span>
        <span
          class:list={[
            'relative z-10 font-editorial font-semibold tracking-[0.06em] whitespace-nowrap',
            isHero ? 'text-[24px]' : 'text-[20px]',
          ]}
          style="writing-mode: vertical-rl; text-orientation: mixed;"
        >
          MySQL
        </span>
        <svg class="relative z-10 w-[21px] h-[27px] opacity-90" viewBox="0 0 24 30" fill="none" stroke="currentColor" stroke-width="1.65">
          <rect x="4" y="3" width="16" height="24" rx="8" />
          <rect x="7.5" y="6.5" width="9" height="10" rx="4.5" />
          <line x1="7.5" y1="12" x2="7.5" y2="23.5" />
        </svg>
      </>
    )}

    {volume.designKey === 'rag' && (
      <>
        <img
          src="/covers/rag-linen.jpg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 w-full h-full object-cover object-left"
        />
        <!-- Classic fine-press copper twin bands on top & bottom of spine -->
        <div class="pointer-events-none absolute top-[62px] left-0 right-0 h-[1.5px] bg-[#DDA15E]/65 z-10"></div>
        <div class="pointer-events-none absolute bottom-[62px] left-0 right-0 h-[1.5px] bg-[#DDA15E]/65 z-10"></div>

        <span class="relative z-10 font-mono-meta text-[9px] font-medium tracking-[0.22em] uppercase text-[#DDA15E]">
          02
        </span>
        <span
          class:list={[
            'relative z-10 font-editorial font-semibold tracking-[0.14em] whitespace-nowrap text-[#EFEBE0]',
            isHero ? 'text-[25px]' : 'text-[21px]',
          ]}
          style="writing-mode: vertical-rl; text-orientation: mixed;"
        >
          RAG
        </span>
        <svg class="relative z-10 w-[20px] h-[26px] text-[#DDA15E]/90" viewBox="0 0 24 30" fill="none" stroke="currentColor" stroke-width="1.65">
          <rect x="4" y="3" width="16" height="24" rx="8" />
          <rect x="7.5" y="6.5" width="9" height="10" rx="4.5" />
          <line x1="7.5" y1="12" x2="7.5" y2="23.5" />
        </svg>
      </>
    )}
  </div>

  <!-- 4. FORE-EDGE RECESSED IVORY PAPER BLOCK -->
  <div class="book3d-face book3d-pages-right"></div>

  <!-- 5. TOP & BOTTOM PAPER BLOCKS -->
  <div class="book3d-face book3d-pages-top"></div>
  <div class="book3d-face book3d-pages-bottom"></div>
</div>
