---
import type { VolumeMeta } from '../data/volumes';

interface Props {
  volume: VolumeMeta;
  noteCount: number;
  size?: 'md' | 'lg';
  interactive?: boolean;
}

const { volume, noteCount, size = 'md', interactive = true } = Astro.props;
const isLarge = size === 'lg';
---

<div
  class:list={[
    'press-book select-none flex flex-col justify-between relative',
    !interactive && 'press-book-static',
    isLarge ? 'aspect-[3/4] w-full max-w-[300px] p-7' : 'aspect-[3/3.85] w-full p-5 sm:p-6',
  ]}
  style={`background-color: ${volume.coverBg}; color: ${volume.coverText};`}
>
  <!-- Subtle Swiss Geometric Cover Artwork -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-[0.18]" aria-hidden="true">
    {volume.motif === 'grid' && (
      <svg class="w-full h-full" viewBox="0 0 240 320" fill="none">
        <g stroke="currentColor" stroke-width="0.9">
          <line x1="48" y1="0" x2="48" y2="320" />
          <line x1="96" y1="0" x2="96" y2="320" />
          <line x1="144" y1="0" x2="144" y2="320" />
          <line x1="192" y1="0" x2="192" y2="320" />
          <line x1="0" y1="140" x2="240" y2="140" />
          <line x1="0" y1="188" x2="240" y2="188" />
          <line x1="0" y1="236" x2="240" y2="236" />
        </g>
        <rect x="96" y="140" width="96" height="96" fill={volume.coverAccent} fill-opacity="0.45" />
      </svg>
    )}
    {volume.motif === 'rings' && (
      <svg class="w-full h-full" viewBox="0 0 240 320" fill="none">
        <circle cx="176" cy="216" r="112" stroke="currentColor" stroke-width="1" />
        <circle cx="176" cy="216" r="82" stroke="currentColor" stroke-width="1" />
        <circle cx="176" cy="216" r="52" stroke={volume.coverAccent} stroke-width="1.6" />
        <circle cx="176" cy="216" r="22" fill={volume.coverAccent} fill-opacity="0.55" />
      </svg>
    )}
    {volume.motif === 'strata' && (
      <svg class="w-full h-full" viewBox="0 0 240 320" fill="none">
        <rect x="28" y="150" width="184" height="22" stroke="currentColor" stroke-width="1" />
        <rect x="28" y="182" width="184" height="22" fill={volume.coverAccent} fill-opacity="0.4" />
        <rect x="28" y="214" width="184" height="22" stroke="currentColor" stroke-width="1" />
        <rect x="28" y="246" width="124" height="22" stroke="currentColor" stroke-width="1" />
      </svg>
    )}
    {volume.motif === 'waves' && (
      <svg class="w-full h-full" viewBox="0 0 240 320" fill="none">
        <path d="M0 175 Q60 140 120 175 T240 175" stroke="currentColor" stroke-width="1.3" />
        <path d="M0 202 Q60 167 120 202 T240 202" stroke="currentColor" stroke-width="1.3" />
        <path d="M0 229 Q60 194 120 229 T240 229" stroke={volume.coverAccent} stroke-width="2" />
        <path d="M0 256 Q60 221 120 256 T240 256" stroke="currentColor" stroke-width="1.3" />
      </svg>
    )}
    {volume.motif === 'constellation' && (
      <svg class="w-full h-full" viewBox="0 0 240 320" fill="none">
        <path d="M52 248 L108 188 L174 212 L198 144" stroke="currentColor" stroke-width="1.2" />
        <path d="M108 188 L138 134 L198 144" stroke={volume.coverAccent} stroke-width="1.4" />
        <circle cx="52" cy="248" r="4" fill="currentColor" />
        <circle cx="108" cy="188" r="5" fill={volume.coverAccent} />
        <circle cx="174" cy="212" r="4" fill="currentColor" />
        <circle cx="138" cy="134" r="4" fill="currentColor" />
        <circle cx="198" cy="144" r="6" fill={volume.coverAccent} />
      </svg>
    )}
  </div>

  <!-- Top Strip: Volume Index + Accent Rule -->
  <div class="relative z-10 pl-2">
    <div class="flex items-center justify-between gap-2 pb-3 border-b" style="border-color: currentColor; border-bottom-color: color-mix(in srgb, currentColor 24%, transparent);">
      <span class="font-mono-meta text-[11px] tracking-[0.14em] uppercase opacity-85">
        {volume.number}
      </span>
      <span
        class="inline-block w-2 h-2 rounded-full"
        style={`background-color: ${volume.coverAccent};`}
      ></span>
    </div>

    <div class={isLarge ? 'mt-6' : 'mt-4'}>
      <p class="font-mono-meta text-[10px] tracking-[0.12em] uppercase opacity-70 mb-2">
        {volume.englishTitle}
      </p>
      <h3
        class:list={[
          'font-editorial font-bold leading-[1.18] tracking-tight',
          isLarge ? 'text-[1.7rem]' : 'text-[1.35rem]',
        ]}
      >
        {volume.title}
      </h3>
      <p class="mt-2.5 text-xs leading-relaxed opacity-80 line-clamp-2">
        {volume.subtitle}
      </p>
    </div>
  </div>

  <!-- Bottom Imprint Colophon -->
  <div class="relative z-10 pl-2 pt-3 border-t flex items-end justify-between gap-2" style="border-top-color: color-mix(in srgb, currentColor 22%, transparent);">
    <div>
      <div class="font-mono-meta text-[10px] tracking-[0.14em] uppercase opacity-75">
        PEBBLE PRESS
      </div>
      <div class="text-[11px] opacity-65 mt-0.5">{volume.edition}</div>
    </div>
    <div class="font-mono-meta text-[11px] px-2 py-0.5 rounded-sm" style={`background-color: color-mix(in srgb, ${volume.coverAccent} 22%, transparent); color: ${volume.coverText};`}>
      {String(noteCount).padStart(2, '0')} 篇
    </div>
  </div>
</div>
